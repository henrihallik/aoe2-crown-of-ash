/* Compatibility: Definitive Edition */
/*
    Crown of Ash v1.0.0
    Designed for Age of Empires II: Definitive Edition.

    Recommended:
      - 2 to 8 players
      - Random Map or Regicide
      - Standard resources
      - Any standard map size appropriate for the player count

    Gameplay:
      - Every player starts in a resource-balanced forest clearing.
      - Each clearing has a guaranteed road to the raised central Crown.
      - Team games also receive narrow roads between allied clearings.
      - The capturable Crown grants 24 gold per minute.
      - Rich central mines are protected by hostile neutral wardens.
      - Four unconnected ash caches hide randomized bonus resources.

    This script intentionally targets Update 153015 or newer. It uses the
    current DE commands set_circular_base, generate_mode,
    create_connect_land_zones, create_object_group, and
    avoid_other_land_zones.
*/

/* Terrain aliases */
#const ASH_FOREST 19
#const START_GROUND 12
#const CROWN_GROUND 45
#const CACHE_GROUND 70
#const TEAM_PATH 5
#const CROWN_PATH 11
#const FLOWER_GROUND 122

/* Classic and DE object aliases */
#const CROWN_MONUMENT 826
#const WARDEN_WOLF 126
#const WARDEN_DIRE_WOLF 89
#const WARDEN_JAGUAR 812
#const START_SHEEP 594
#const START_TURKEY 833
#const START_PINE 350
#const CACHE_BERRIES 59
#const CACHE_GOLD 66
#const CACHE_STONE 102
#const CENTER_BONFIRE 304
#const CENTER_CRACKS 241
#const CENTER_SKELETON 710

/* Stable identifiers used by placement constraints. */
#const CROWN_LAND_ID 200
#const CACHE_LAND_A 301
#const CACHE_LAND_B 302
#const CACHE_LAND_C 303
#const CACHE_LAND_D 304
#const REGICIDE_CASTLE_AREA 1200
#const CROWN_MONUMENT_AREA 9001
#const CROWN_TREASURE_AREA 9002

<PLAYER_SETUP>

random_placement
behavior_version 2
ai_info_map_type BLACK_FOREST 0 0 0

/* Flag 2 activates ResourceDelta / 100 per second while the Crown is held. */
guard_state CROWN_MONUMENT AMOUNT_GOLD 40 2


<LAND_GENERATION>

base_terrain ASH_FOREST

/* Fixed per-player area keeps the available starting space consistent. */
create_player_lands {
    terrain_type START_GROUND
    number_of_tiles 1800
    base_size 16
    set_circular_base
    /*
        Keep at least about 20 tiles between a cardinal start and the map edge
        so the far starting mines still have a full placement arc.
    */
    if TINY_MAP
        circle_radius 31 1
    elseif SMALL_MAP
        circle_radius 34 1
    elseif MEDIUM_MAP
        circle_radius 36 2
    elseif LARGE_MAP
        circle_radius 38 2
    elseif HUGE_MAP
        circle_radius 38 2
    elseif GIGANTIC_MAP
        circle_radius 39 2
    elseif LUDIKRIS_MAP
        circle_radius 42 2
    endif
    left_border 6
    right_border 6
    top_border 6
    bottom_border 6
    border_fuzziness 14
    clumping_factor 6
    zone 1
    other_zone_avoidance_distance 7
    base_elevation 1
}

/* One raised neutral land anchors every guaranteed center road. */
create_land {
    terrain_type CROWN_GROUND
    land_percent 5
    base_size 13
    set_circular_base
    land_position 50 50
    border_fuzziness 8
    clumping_factor 6
    zone 2
    other_zone_avoidance_distance 7
    base_elevation 5
    land_id CROWN_LAND_ID
}

/*
    These bonus clearings use the post-153015 free placement mode. They remain
    deliberately unconnected: finding and chopping into one is the reward.
*/
create_land {
    terrain_type CACHE_GROUND
    number_of_tiles 90
    base_size 4
    set_circular_base
    generate_mode 1
    left_border 10
    right_border 10
    top_border 10
    bottom_border 10
    border_fuzziness 8
    zone 3
    other_zone_avoidance_distance 5
    min_placement_distance 15
    land_id CACHE_LAND_A
}

create_land {
    terrain_type CACHE_GROUND
    number_of_tiles 90
    base_size 4
    set_circular_base
    generate_mode 1
    left_border 10
    right_border 10
    top_border 10
    bottom_border 10
    border_fuzziness 8
    zone 3
    other_zone_avoidance_distance 5
    min_placement_distance 15
    land_id CACHE_LAND_B
}

create_land {
    terrain_type CACHE_GROUND
    number_of_tiles 90
    base_size 4
    set_circular_base
    generate_mode 1
    left_border 10
    right_border 10
    top_border 10
    bottom_border 10
    border_fuzziness 8
    zone 3
    other_zone_avoidance_distance 5
    min_placement_distance 15
    land_id CACHE_LAND_C
}

create_land {
    terrain_type CACHE_GROUND
    number_of_tiles 90
    base_size 4
    set_circular_base
    generate_mode 1
    left_border 10
    right_border 10
    top_border 10
    bottom_border 10
    border_fuzziness 8
    zone 3
    other_zone_avoidance_distance 5
    min_placement_distance 15
    land_id CACHE_LAND_D
}


<TERRAIN_GENERATION>

/* Small flowered patches add readable visual texture away from each TC. */
create_terrain FLOWER_GROUND {
    base_terrain START_GROUND
    land_percent 6
    number_of_clumps 3
    clumping_factor 12
    set_scale_by_size
    set_avoid_player_start_areas 8
}


<CONNECTION_GENERATION>

accumulate_connections

/* Allies gain a narrow rear route in team games. */
create_connect_teams_lands {
    replace_terrain ASH_FOREST TEAM_PATH
    terrain_cost ASH_FOREST 1
    terrain_cost START_GROUND 1
    terrain_cost CROWN_GROUND 5
    terrain_cost CACHE_GROUND 0
    terrain_size ASH_FOREST 2 1
}

/*
    Zone 1 contains only player clearings and zone 2 only the Crown, producing
    exactly the intended family of player-to-center roads.
*/
create_connect_land_zones 1 2 {
    replace_terrain ASH_FOREST CROWN_PATH
    replace_terrain TEAM_PATH CROWN_PATH
    terrain_cost ASH_FOREST 1
    terrain_cost TEAM_PATH 1
    terrain_cost START_GROUND 1
    terrain_cost CROWN_GROUND 1
    terrain_cost CACHE_GROUND 0
    terrain_size ASH_FOREST 3 1
    terrain_size TEAM_PATH 2 0
}


<OBJECTS_GENERATION>

/*
    Object groups were added in Update 153015. Starting food stays equivalent;
    neutral rewards and wardens are allowed to vary because they are contested.
*/
create_object_group START_HERDABLE {
    add_object START_SHEEP 50
    add_object START_TURKEY 50
}

create_object_group CROWN_WARDEN {
    add_object WARDEN_WOLF 55
    add_object WARDEN_JAGUAR 30
    add_object WARDEN_DIRE_WOLF 15
}

create_object_group CACHE_TREASURE {
    add_object CACHE_GOLD 45
    add_object CACHE_STONE 35
    add_object CACHE_BERRIES 20
}

/* Mandatory starts are placed before all optional resources. */
create_object TOWN_CENTER {
    set_place_for_every_player
    min_distance_to_players 0
    max_distance_to_players 0
    avoid_other_land_zones 3
    actor_area 1000
    actor_area_radius 7
}

if REGICIDE
    create_object CASTLE {
        set_place_for_every_player
        min_distance_to_players 9
        max_distance_to_players 12
        find_closest_to_map_edge
        avoid_forest_zone 2
        avoid_other_land_zones 3
        actor_area REGICIDE_CASTLE_AREA
        actor_area_radius 5
    }
endif

create_object VILLAGER {
    set_place_for_every_player
    min_distance_to_players 4
    max_distance_to_players 6
    find_closest
    force_placement
    avoid_other_land_zones 3
}

create_object SCOUT {
    set_place_for_every_player
    min_distance_to_players 6
    max_distance_to_players 8
    find_closest
    force_placement
    avoid_other_land_zones 3
}

if REGICIDE
    create_object KING {
        set_place_for_every_player
        min_distance_to_players 4
        max_distance_to_players 7
        find_closest
        force_placement
        avoid_other_land_zones 3
    }

    create_object VILLAGER {
        number_of_objects 7
        set_place_for_every_player
        min_distance_to_players 5
        max_distance_to_players 8
        force_placement
        avoid_other_land_zones 3
    }
endif

/* Death Match and infinite-resource games do not need Dark Age clutter. */
if DEATH_MATCH
elseif INFINITE_RESOURCES
else
    create_object START_HERDABLE {
        number_of_objects 4
        number_of_groups 1
        group_placement_radius 2
        set_tight_grouping
        set_gaia_object_only
        set_place_for_every_player
        min_distance_to_players 5
        max_distance_to_players 8
        find_closest
        avoid_forest_zone 1
        avoid_other_land_zones 3
        if REGICIDE
            avoid_actor_area REGICIDE_CASTLE_AREA
        endif
    }

    create_object START_HERDABLE {
        number_of_objects 4
        number_of_groups 1
        group_placement_radius 3
        set_tight_grouping
        set_gaia_object_only
        set_place_for_every_player
        min_distance_to_players 9
        max_distance_to_players 12
        avoid_forest_zone 1
        avoid_other_land_zones 3
        if REGICIDE
            avoid_actor_area REGICIDE_CASTLE_AREA
        endif
    }

    create_object FORAGE {
        number_of_objects 6
        number_of_groups 1
        group_placement_radius 2
        set_tight_grouping
        set_gaia_object_only
        set_place_for_every_player
        min_distance_to_players 10
        max_distance_to_players 14
        temp_min_distance_group_placement 3
        avoid_forest_zone 2
        avoid_other_land_zones 3
        if REGICIDE
            avoid_actor_area REGICIDE_CASTLE_AREA
        endif
    }

    create_object BOAR {
        number_of_objects 2
        number_of_groups 1
        group_placement_radius 5
        set_loose_grouping
        set_gaia_object_only
        set_place_for_every_player
        min_distance_to_players 14
        max_distance_to_players 18
        temp_min_distance_group_placement 3
        avoid_forest_zone 1
        avoid_other_land_zones 3
        if REGICIDE
            avoid_actor_area REGICIDE_CASTLE_AREA
        endif
    }

    create_object DEER {
        number_of_objects 4
        number_of_groups 1
        group_placement_radius 4
        set_loose_grouping
        set_gaia_object_only
        set_place_for_every_player
        min_distance_to_players 14
        max_distance_to_players 19
        temp_min_distance_group_placement 3
        avoid_forest_zone 1
        avoid_other_land_zones 3
        if REGICIDE
            avoid_actor_area REGICIDE_CASTLE_AREA
        endif
    }

    create_object START_PINE {
        number_of_objects 5
        set_gaia_object_only
        set_place_for_every_player
        min_distance_to_players 5
        max_distance_to_players 9
        temp_min_distance_group_placement 1
        avoid_other_land_zones 3
        if REGICIDE
            avoid_actor_area REGICIDE_CASTLE_AREA
        endif
    }

    create_object GOLD {
        number_of_objects 7
        number_of_groups 1
        group_placement_radius 3
        set_tight_grouping
        set_gaia_object_only
        set_place_for_every_player
        min_distance_to_players 11
        max_distance_to_players 15
        temp_min_distance_group_placement 4
        avoid_forest_zone 2
        avoid_other_land_zones 3
        if REGICIDE
            avoid_actor_area REGICIDE_CASTLE_AREA
        endif
        actor_area 1100
        actor_area_radius 4
    }

    create_object STONE {
        number_of_objects 5
        number_of_groups 1
        group_placement_radius 3
        set_tight_grouping
        set_gaia_object_only
        set_place_for_every_player
        min_distance_to_players 15
        max_distance_to_players 19
        temp_min_distance_group_placement 4
        avoid_forest_zone 2
        avoid_other_land_zones 3
        if REGICIDE
            avoid_actor_area REGICIDE_CASTLE_AREA
        endif
        avoid_actor_area 1100
    }

    create_object GOLD {
        number_of_objects 4
        number_of_groups 1
        group_placement_radius 2
        set_tight_grouping
        set_gaia_object_only
        set_place_for_every_player
        min_distance_to_players 17
        max_distance_to_players 20
        temp_min_distance_group_placement 5
        avoid_forest_zone 2
        avoid_other_land_zones 3
        if REGICIDE
            avoid_actor_area REGICIDE_CASTLE_AREA
        endif
        avoid_actor_area 1100
    }
endif

/*
    The Crown is always neutral, capturable, and indestructible. Holding it
    activates the guard_state gold trickle configured in PLAYER_SETUP.
*/
create_object CROWN_MONUMENT {
    place_on_specific_land_id CROWN_LAND_ID
    set_gaia_object_only
    set_building_capturable
    make_indestructible
    ignore_terrain_restrictions
    find_closest_to_map_center
    actor_area CROWN_MONUMENT_AREA
    actor_area_radius 5
}

/* Central mines: valuable enough to matter, exposed enough to contest. */
create_object GOLD {
    number_of_objects 10
    number_of_groups 1
    group_placement_radius 10
    set_loose_grouping
    set_gaia_object_only
    place_on_specific_land_id CROWN_LAND_ID
    find_closest_to_map_center
    resource_delta 200
    temp_min_distance_group_placement 2
    avoid_actor_area CROWN_MONUMENT_AREA
    actor_area CROWN_TREASURE_AREA
    actor_area_radius 12
}

create_object STONE {
    number_of_objects 8
    number_of_groups 1
    group_placement_radius 10
    set_loose_grouping
    set_gaia_object_only
    place_on_specific_land_id CROWN_LAND_ID
    resource_delta 150
    temp_min_distance_group_placement 2
    avoid_actor_area CROWN_MONUMENT_AREA
}

create_object RELIC {
    number_of_objects 5
    set_gaia_object_only
    place_on_specific_land_id CROWN_LAND_ID
    temp_min_distance_group_placement 6
    avoid_actor_area CROWN_MONUMENT_AREA
}

create_object CROWN_WARDEN {
    number_of_objects 7
    set_gaia_object_only
    set_gaia_unconvertible
    actor_area_to_place_in CROWN_TREASURE_AREA
    temp_min_distance_group_placement 2
    avoid_actor_area CROWN_MONUMENT_AREA
}

/* Four mixed treasure clusters reward exploration beyond the main roads. */
create_object CACHE_TREASURE {
    number_of_objects 4
    number_of_groups 4
    group_placement_radius 2
    set_tight_grouping
    set_gaia_object_only
    terrain_to_place_on CACHE_GROUND
    temp_min_distance_group_placement 16
}

create_object CROWN_WARDEN {
    number_of_objects 1
    number_of_groups 4
    set_gaia_object_only
    set_gaia_unconvertible
    terrain_to_place_on CACHE_GROUND
    temp_min_distance_group_placement 16
}

/* Sparse landmarks make the Crown readable without blocking combat space. */
create_object CENTER_BONFIRE {
    number_of_objects 4
    set_gaia_object_only
    place_on_specific_land_id CROWN_LAND_ID
    min_distance_group_placement 5
    avoid_actor_area CROWN_MONUMENT_AREA
}

create_object CENTER_CRACKS {
    number_of_objects 6
    set_gaia_object_only
    place_on_specific_land_id CROWN_LAND_ID
    min_distance_group_placement 3
    avoid_actor_area CROWN_MONUMENT_AREA
}

create_object CENTER_SKELETON {
    number_of_objects 5
    set_gaia_object_only
    place_on_specific_land_id CROWN_LAND_ID
    min_distance_group_placement 3
    avoid_actor_area CROWN_MONUMENT_AREA
}
